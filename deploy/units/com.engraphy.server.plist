<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local/overlay profile, macOS (design/04's single-host posture). Install:
    cp com.engraphy.server.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.engraphy.server.plist
  Logs land at the paths below; launchctl unload to stop.

  Secrets: EnvironmentVariables below is the plaintext on disk path launchd
  offers (unlike systemd's EnvironmentFile, there is no separate file
  indirection with tighter permissions), so keep this plist itself at 0600
  and owned by the running user, since ENGRAPHY_DATABASE_URL's password lives
  here directly.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.engraphy.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/engraphy/.venv/bin/python</string>
        <string>-m</string>
        <string>engraphy.server.app</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/engraphy</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ENGRAPHY_DATABASE_URL</key>
        <string>postgres://engram_app:CHANGE_ME@localhost:5432/engram?sslmode=disable</string>
        <key>ENGRAPHY_BIND_HOST</key>
        <string>127.0.0.1</string>
        <key>ENGRAPHY_BIND_PORT</key>
        <string>8000</string>
        <key>ENGRAPHY_LAST_BACKUP_STATUS_FILE</key>
        <string>/opt/engraphy/var/last_backup_at</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/opt/engraphy/var/log/engraphy.out.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/engraphy/var/log/engraphy.err.log</string>
</dict>
</plist>
