# Copy to `.env` next to compose.yaml and fill in. `.env` is git-ignored:
# never commit it, and never put a minted Engraphy bearer token in here (tokens
# are display-once output from `engraphy-admin token create`).

# Postgres superuser password. Used by postgres itself, the init step, and the
# admin sidecar. Any strong random string.
POSTGRES_PASSWORD=replace-me-with-a-random-string

# Password for the non-superuser `engraphy_app` role the server connects as.
# Deliberately different from POSTGRES_PASSWORD: the server is not a superuser.
# A deployment provisioned before migration 0024 has this role named
# `engram_app`; 0024 renames it, and the DSNs must be updated to match --
# see COMPATIBILITY.md.
ENGRAPHY_APP_ROLE_PASSWORD=replace-me-with-a-different-random-string

# Host port the server is published on (loopback only). Change it if 8000 is
# already taken; nothing else needs to change. up.sh / up.ps1 write this line
# for you on first run.
ENGRAPHY_HOST_PORT=8000
