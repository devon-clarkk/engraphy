# setuptools build dir (left by `pip install .`)
build/

# Benchmark run artifacts (design/09) -- machine output, kept out of git.
runs/

# Benchmark datasets (design/09). CC BY-NC 4.0 for LoCoMo -- not ours to
# redistribute, and 2.8 MB besides. Acquire with bench/datasets/README.md.
# Root-anchored: an unanchored `datasets/` would also swallow the committed
# bench/datasets/ acquisition instructions.
/datasets/

# Raw retrieval envelopes sidecar (diagnostics) — large, kept out of git
**/envelopes.jsonl

# Local HuggingFace caches from containerised measurement runs (HF_HOME mounted
# into the repo). Never committed: the graphs are hundreds of megabytes.
.hfc/
.hfcache-linux/
